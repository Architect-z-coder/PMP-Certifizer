# URL of the FastAPI backend (no trailing slash)
VITE_API_URL=http://localhost:8000

# Interface. Unset (or anything but "chantier") = current interface (App.jsx).
# "chantier" = the new Chantier interface (src/ui2/App2.jsx). Vite bakes this in at build time:
# set it in Vercel → Project → Settings → Environment Variables, then redeploy.
VITE_UI=
