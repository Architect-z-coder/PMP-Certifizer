{
  "mcpServers": {
    "blender": {
      "command": "${USERPROFILE}\\.local\\bin\\uvx.exe",
      "args": ["--python", "3.12", "blender-mcp"]
    },
    "meshy": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@meshy-ai/meshy-mcp-server"],
      "env": { "MESHY_API_KEY": "${MESHY_API_KEY}" }
    }
  }
}
